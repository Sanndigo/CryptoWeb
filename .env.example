ENV=production
# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production

# Database configuration (When running in Docker, use the service names)
DATABASE_URL=postgresql+asyncpg://share_user:share_password@postgres:5432/sharedb
REDIS_URL=redis://redis:6379/0

# Production CORS
CORS_ORIGINS=https://your-domain.com
