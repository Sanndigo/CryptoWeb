---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="webcrypt60 - Online encoder, decoder, hash and encrypt tool." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <header class="border-b border-neon-green/30 p-4 sticky top-0 bg-black-bg/90 backdrop-blur z-10">
        <div class="container mx-auto flex items-center justify-between">
          <h1 class="text-3xl font-bold tracking-tighter">
            <span class="text-pure-white">webcrypt</span><span class="text-neon-green">60</span>
          </h1>
          <div class="text-xs text-light-gray font-mono uppercase tracking-widest border border-dark-gray px-2 py-1">
            System Online
          </div>
        </div>
      </header>
      
      <main class="flex-grow container mx-auto p-4 md:p-8">
        <slot />
      </main>

      <footer class="border-t border-neon-green/30 p-4 text-center font-mono text-xs text-light-gray mt-8">
        &copy; {new Date().getFullYear()} webcrypt60. Secure execution environment.
      </footer>
    </div>
  </body>
</html>
