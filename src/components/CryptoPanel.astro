---
// CryptoPanel.astro
---
<div class="flex flex-col gap-6 w-full">

  <!-- ── Operation & Method Selectors ───────────────────────────────────── -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 panel-border bg-[#141416]/60 backdrop-blur-[20px] p-4 rounded-sm relative group z-30">
    <div class="corner-tl corner-accent group-hover:border-primary-fixed-dim"></div>
    <div class="corner-tr corner-accent group-hover:border-primary-fixed-dim"></div>
    <div class="corner-bl corner-accent group-hover:border-primary-fixed-dim"></div>
    <div class="corner-br corner-accent group-hover:border-primary-fixed-dim"></div>
    
    <!-- Custom Dropdowns -->
    <div class="relative z-40" id="catDropContainer">
      <label class="font-label-caps text-label-caps text-primary-fixed-dim mb-2 block">OPERATION CATEGORY</label>
      <div class="relative">
        <button id="catBtn" class="w-full bg-black/40 border border-outline-variant hover:border-primary-fixed-dim rounded-sm py-2 pl-3 pr-8 font-code-block text-code-block text-on-surface text-left cursor-pointer transition-colors outline-none flex justify-between items-center">
          <span id="catLabel">HASHING</span>
          <span class="material-symbols-outlined text-on-surface-variant">arrow_drop_down</span>
        </button>
        <div id="catMenu" class="absolute animate-slide-down left-0 right-0 top-full mt-1 bg-surface-container-lowest border border-outline-variant rounded-sm shadow-[0_0_15px_rgba(0,0,0,0.5)] hidden flex flex-col max-h-60 overflow-y-auto">
          <button class="cat-opt text-left px-4 py-3 font-code-block text-code-block text-on-surface hover:bg-primary/20 hover:text-primary transition-colors border-b border-outline-variant/30" data-val="hashing">HASHING</button>
          <button class="cat-opt text-left px-4 py-3 font-code-block text-code-block text-on-surface hover:bg-primary/20 hover:text-primary transition-colors border-b border-outline-variant/30" data-val="encoding">ENCODING</button>
          <button class="cat-opt text-left px-4 py-3 font-code-block text-code-block text-on-surface hover:bg-primary/20 hover:text-primary transition-colors border-b border-outline-variant/30" data-val="encryption">ENCRYPTION</button>
          <button class="cat-opt text-left px-4 py-3 font-code-block text-code-block text-on-surface hover:bg-primary/20 hover:text-primary transition-colors" data-val="formatting">FORMATTING</button>
        </div>
      </div>
    </div>
    
    <div class="relative z-30" id="metDropContainer">
      <label class="font-label-caps text-label-caps text-primary-fixed-dim mb-2 block">SPECIFIC METHOD</label>
      <div class="relative">
        <button id="metBtn" class="w-full bg-black/40 border border-outline-variant hover:border-primary-fixed-dim rounded-sm py-2 pl-3 pr-8 font-code-block text-code-block text-on-surface text-left cursor-pointer transition-colors outline-none flex justify-between items-center">
          <span id="metLabel">MD5</span>
          <span class="material-symbols-outlined text-on-surface-variant">arrow_drop_down</span>
        </button>
        <div id="metMenu" class="absolute animate-slide-down left-0 right-0 top-full mt-1 bg-surface-container-lowest border border-outline-variant rounded-sm shadow-[0_0_15px_rgba(0,0,0,0.5)] hidden flex flex-col max-h-60 overflow-y-auto">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- ── Bento Grid Layout for Input & Output ───────────────────────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-panel-gap bg-outline-variant rounded-sm overflow-hidden panel-border relative z-10 transition-all duration-300 ease-in-out">
    
    <!-- Left Panel: Original Payload -->
    <div class="bg-[#141416]/80 backdrop-blur-[20px] p-6 relative flex flex-col min-h-[300px] transition-all duration-300 ease-in-out">
      <div class="absolute top-0 left-0 bg-surface-container-lowest px-2 py-1 font-status-label text-status-label text-on-surface-variant border-b border-r border-outline-variant rounded-br-sm">
        [SEC_LAYER_01] INPUT_BUFFER
      </div>
      
      <div class="mt-8 flex-1 flex flex-col">
        <div class="flex justify-between items-center mb-4">
          <h2 class="font-headline-md text-headline-md text-primary">Original Payload</h2>
          <span id="charCount" class="font-code-block text-code-block text-outline">0 / 1000</span>
        </div>
        
        <textarea id="sourceText" class="w-full bg-black/40 border border-outline-variant focus:border-primary-fixed-dim rounded-sm p-4 font-code-block text-code-block text-on-surface/80 flex-1 resize-y outline-none transition-colors custom-scroll" placeholder="Enter payload to process..." maxlength="1000"></textarea>
        
        <!-- Key row -->
        <div id="keyContainerWrapper" class="expand-wrapper">
          <div class="expand-inner">
            <div id="keyContainerInner" class="pt-4 flex flex-col gap-2 opacity-0 transition-opacity duration-300">
              <label for="secretKey" class="font-label-caps text-label-caps text-secondary-fixed-dim flex justify-between">
                <span>Secret Key</span>
                <span class="text-on-surface-variant font-code-block text-[11px]">(Required for encryption)</span>
              </label>
              <input type="text" id="secretKey" class="w-full bg-black/40 border border-outline-variant focus:border-secondary-fixed-dim rounded-sm py-2 px-3 font-code-block text-code-block text-on-surface outline-none transition-colors" placeholder="Enter or generate symmetric key..." maxlength="256" />
            </div>
          </div>
        </div>
        
        <!-- Advanced toggle -->
        <div class="mt-4 pt-3 border-t border-outline-variant flex items-center justify-between">
          <button id="advancedToggle" class="flex items-center gap-2 group outline-none">
            <span class="font-label-caps text-label-caps text-on-surface-variant group-hover:text-primary transition-colors">ADVANCED SETTINGS</span>
            <span id="advChevron" class="font-code-block text-code-block text-primary w-4 transition-transform">+</span>
          </button>
          <span class="font-status-label text-status-label text-outline-variant">STATUS: <span id="apiStatus" class="text-primary-fixed-dim pulse-slow">READY</span></span>
        </div>
        
        <!-- Advanced Settings Panel -->
        <div id="advancedWrapper" class="expand-wrapper">
          <div class="expand-inner">
            <div id="advancedInner" class="mt-3 border border-primary/20 bg-black/60 p-4 space-y-5 rounded-sm opacity-0 transition-opacity duration-300">
           
           <!-- AES/ChaCha Settings -->
           <div id="advAesSettings" class="hidden">
             <div class="flex items-center gap-2 mb-3">
               <span class="font-label-caps text-label-caps text-primary-fixed-dim">AES / CHACHA CONFIG</span>
               <div class="flex-1 h-px bg-primary-fixed-dim/20"></div>
             </div>
             <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
               <div>
                 <span class="font-status-label text-status-label text-on-surface-variant block mb-1">KEY SIZE</span>
                 <div class="flex gap-1">
                   <button class="adv-keybits font-code-block text-[11px] px-2 py-1 border border-outline-variant text-on-surface-variant hover:text-primary transition-colors active-adv" data-bits="128">128</button>
                   <button class="adv-keybits font-code-block text-[11px] px-2 py-1 border border-outline-variant text-on-surface-variant hover:text-primary transition-colors active-adv" data-bits="192">192</button>
                   <button class="adv-keybits font-code-block text-[11px] px-2 py-1 border border-primary-fixed-dim text-primary-fixed-dim transition-colors active-adv" data-bits="256">256</button>
                 </div>
               </div>
               <div>
                 <span class="font-status-label text-status-label text-on-surface-variant block mb-1">OUTPUT FORMAT</span>
                 <div class="flex gap-1">
                   <button class="adv-aes-fmt font-code-block text-[11px] px-2 py-1 border border-primary-fixed-dim text-primary-fixed-dim active-adv" data-fmt="base64">B64</button>
                   <button class="adv-aes-fmt font-code-block text-[11px] px-2 py-1 border border-outline-variant text-on-surface-variant hover:text-primary transition-colors" data-fmt="hex">HEX</button>
                 </div>
               </div>
               <div>
                 <span class="font-status-label text-status-label text-on-surface-variant block mb-1">AAD (AUTH. DATA)</span>
                 <input id="aesAad" type="text" class="w-full bg-black/40 border border-outline-variant rounded-sm py-1 px-2 font-code-block text-[11px] text-on-surface outline-none focus:border-primary-fixed-dim" placeholder="Optional..." />
               </div>
             </div>
           </div>

           <!-- 3DES Settings -->
           <div id="advDesSettings" class="hidden">
             <div class="flex items-center gap-2 mb-3">
               <span class="font-label-caps text-label-caps text-error">3DES CONFIG</span>
               <div class="flex-1 h-px bg-error/20"></div>
             </div>
             <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
               <div>
                 <span class="font-status-label text-status-label text-on-surface-variant block mb-1">OUTPUT FORMAT</span>
                 <div class="flex gap-1">
                   <button class="adv-des-fmt font-code-block text-[11px] px-2 py-1 border border-primary-fixed-dim text-primary-fixed-dim active-adv" data-fmt="base64">B64</button>
                   <button class="adv-des-fmt font-code-block text-[11px] px-2 py-1 border border-outline-variant text-on-surface-variant hover:text-primary transition-colors" data-fmt="hex">HEX</button>
                 </div>
               </div>
             </div>
           </div>

           <!-- XOR Settings -->
           <div id="advXorSettings" class="hidden">
             <div class="flex items-center gap-2 mb-3">
               <span class="font-label-caps text-label-caps text-primary">XOR CONFIG</span>
               <div class="flex-1 h-px bg-primary/20"></div>
             </div>
             <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
               <div>
                 <span class="font-status-label text-status-label text-on-surface-variant block mb-1">OUTPUT FORMAT</span>
                 <div class="flex gap-1">
                   <button class="adv-xor-fmt font-code-block text-[11px] px-2 py-1 border border-primary-fixed-dim text-primary-fixed-dim active-adv" data-fmt="base64">B64</button>
                   <button class="adv-xor-fmt font-code-block text-[11px] px-2 py-1 border border-outline-variant text-on-surface-variant hover:text-primary transition-colors" data-fmt="hex">HEX</button>
                 </div>
               </div>
             </div>
           </div>

            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Right Panel: Processed Output -->
    <div class="bg-[#141416]/90 backdrop-blur-[20px] p-6 relative flex flex-col glow-effect border-l border-primary/30 transition-all duration-300 ease-in-out">
      <div class="absolute top-0 left-0 bg-primary/10 px-2 py-1 font-status-label text-status-label text-primary border-b border-r border-primary/30 rounded-br-sm flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        [SEC_LAYER_02] OUTPUT_BUFFER
      </div>
      
      <div class="mt-8 flex-1 flex flex-col">
        <div class="flex justify-between items-center mb-4">
          <h2 class="font-headline-md text-headline-md text-secondary-fixed-dim">Processed Output</h2>
          <span id="outputFormatBadge" class="bg-secondary-fixed-dim/20 text-secondary-fixed-dim px-2 py-0.5 rounded-sm font-status-label text-status-label border border-secondary-fixed-dim/30">RESULT</span>
        </div>
        
        <!-- High contrast output box -->
        <div class="bg-black/60 border border-secondary-fixed-dim/50 p-6 rounded-sm flex-1 flex flex-col justify-center relative overflow-hidden group/output min-h-[160px] custom-scroll overflow-y-auto">
          <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiMwZmZiYmIiIGZpbGwtb3BhY2l0eT0iMC4xIi8+PC9zdmc+')] pointer-events-none"></div>
          <div id="resultsContainer" class="font-code-block text-code-block text-secondary break-all leading-loose text-center text-lg tracking-widest selection:bg-secondary-fixed-dim selection:text-background w-full">
            <span class="opacity-50">AWAITING EXECUTION...</span>
          </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="flex gap-4 mt-6">
          <button id="copyOutBtn" class="flex-1 btn-tech py-3 px-4 rounded-sm flex justify-center items-center gap-2 font-label-caps text-label-caps group/btn">
            <span class="material-symbols-outlined text-[18px] group-hover/btn:scale-110 transition-transform">content_copy</span>
            <span id="copyOutText">COPY TO CLIPBOARD</span>
          </button>
          

        </div>
      </div>
    </div>
  </div>


  <!-- ── Utility Modules (KeyGen & Share) ───────────────────────────────── -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-panel-gap relative z-10">
    
    <!-- Key Generator Inline -->
    <div class="bg-[#141416]/60 backdrop-blur-[20px] p-5 relative flex flex-col gap-4 border border-outline-variant rounded-sm panel-border group hover:border-secondary-fixed-dim/50 transition-colors">
      <div class="corner-tl corner-accent group-hover:border-secondary-fixed-dim"></div>
      <div class="corner-tr corner-accent group-hover:border-secondary-fixed-dim"></div>
      <div class="corner-bl corner-accent group-hover:border-secondary-fixed-dim"></div>
      <div class="corner-br corner-accent group-hover:border-secondary-fixed-dim"></div>
      
      <div class="flex items-center gap-2 mb-2">
        <span class="material-symbols-outlined text-secondary-fixed-dim">vpn_key</span>
        <h3 class="font-headline-md text-headline-md text-secondary-fixed-dim">KEY GENERATOR</h3>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div class="relative z-30" id="genTypeDropContainer">
          <label class="font-label-caps text-label-caps text-on-surface-variant mb-1 block">Algorithm</label>
          <div class="relative">
            <button id="genTypeBtn" class="w-full bg-black/40 border border-outline-variant hover:border-secondary-fixed-dim rounded-sm py-2 px-2 font-code-block text-[11px] text-on-surface text-left cursor-pointer transition-colors outline-none flex justify-between items-center">
              <span id="genTypeLabel">AES/ChaCha</span>
              <span class="material-symbols-outlined text-[14px] text-on-surface-variant">arrow_drop_down</span>
            </button>
            <div id="genTypeMenu" class="absolute left-0 right-0 bottom-full mb-1 bg-surface-container-lowest border border-outline-variant rounded-sm shadow-[0_-5px_15px_rgba(0,0,0,0.5)] hidden flex-col z-50 animate-slide-up">
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="AES-256">AES / ChaCha</button>
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="RSA-2048">RSA-2048 Pair</button>
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="RSA-4096">RSA-4096 Pair</button>
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="Ed25519">ECC Ed25519</button>
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="3DES">3DES</button>
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="Fernet">Fernet</button>
              <button class="type-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors" data-val="RandomHex">Random Hex</button>
            </div>
          </div>
        </div>
        <div class="relative z-20" id="genLenDropContainer">
          <label class="font-label-caps text-label-caps text-on-surface-variant mb-1 block">Length</label>
          <div class="relative">
            <button id="genLenBtn" class="w-full bg-black/40 border border-outline-variant hover:border-secondary-fixed-dim rounded-sm py-2 px-2 font-code-block text-[11px] text-on-surface text-left cursor-pointer transition-colors outline-none flex justify-between items-center">
              <span id="genLenLabel">256-bit</span>
              <span class="material-symbols-outlined text-[14px] text-on-surface-variant">arrow_drop_down</span>
            </button>
            <div id="genLenMenu" class="absolute left-0 right-0 bottom-full mb-1 bg-surface-container-lowest border border-outline-variant rounded-sm shadow-[0_-5px_15px_rgba(0,0,0,0.5)] hidden flex-col z-50 animate-slide-up">
              <button class="len-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="256">256-bit</button>
              <button class="len-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors border-b border-outline-variant/30" data-val="192">192-bit</button>
              <button class="len-opt text-left px-3 py-2 font-code-block text-[11px] text-on-surface hover:bg-secondary-fixed-dim/20 hover:text-secondary-fixed-dim transition-colors" data-val="128">128-bit</button>
            </div>
          </div>
        </div>
      </div>

      <div class="flex gap-2">
        <button id="doGenerateKeyBtn" class="btn-tech flex-1 py-2 font-label-caps text-label-caps text-[11px] rounded-sm flex items-center justify-center gap-1 border-secondary-fixed-dim text-secondary-fixed-dim hover:bg-secondary-fixed-dim hover:text-background transition-colors">
          <span class="material-symbols-outlined text-[14px]">refresh</span> GENERATE
        </button>
      </div>

      <div id="keyGenResultWrapper" class="expand-wrapper mt-1">
        <div class="expand-inner">
          <div id="keyGenResultArea" class="flex flex-col gap-3 border-t border-outline-variant pt-3 opacity-0 transition-opacity duration-300">
            
            <!-- Single Key Output -->
            <div id="singleKeyArea" class="flex flex-col gap-2">
              <div class="flex gap-2">
                <input type="text" id="keyGenOutput" readonly class="flex-1 bg-black/60 border border-secondary-fixed-dim/30 p-2 font-code-block text-[11px] text-secondary-fixed-dim outline-none rounded-sm" />
                <button id="copyGenKeyBtn" class="btn-tech px-3 font-label-caps text-[11px] rounded-sm border-secondary-fixed-dim text-secondary-fixed-dim hover:bg-secondary-fixed-dim hover:text-background transition-colors">COPY</button>
              </div>
              <button id="useGenKeyBtn" class="btn-tech w-full py-1.5 font-label-caps text-[11px] rounded-sm text-center border-secondary-fixed-dim text-secondary-fixed-dim hover:bg-secondary-fixed-dim hover:text-background transition-colors">APPLY TO INPUT</button>
            </div>

            <!-- Key Pair Output (Asymmetric) -->
            <div id="keyPairArea" class="hidden flex-col gap-3">
              <div class="flex flex-col gap-1">
                <div class="font-status-label text-[10px] text-primary-fixed-dim flex justify-between">
                  <span>PUBLIC KEY (PEM)</span>
                  <button id="copyPubKeyBtn" class="hover:text-primary transition-colors text-[10px] font-code-block cursor-pointer">[COPY PUBLIC]</button>
                </div>
                <textarea id="pubKeyOutput" readonly rows="3" class="w-full bg-black/60 border border-primary/30 p-2 font-code-block text-[10px] text-primary outline-none rounded-sm resize-none custom-scroll"></textarea>
              </div>
              <div class="flex flex-col gap-1">
                <div class="font-status-label text-[10px] text-secondary-fixed-dim flex justify-between">
                  <span>PRIVATE KEY (PEM)</span>
                  <button id="copyPrivKeyBtn" class="hover:text-secondary-fixed-dim transition-colors text-[10px] font-code-block cursor-pointer">[COPY PRIVATE]</button>
                </div>
                <textarea id="privKeyOutput" readonly rows="4" class="w-full bg-black/60 border border-secondary-fixed-dim/30 p-2 font-code-block text-[10px] text-secondary-fixed-dim outline-none rounded-sm resize-none custom-scroll"></textarea>
              </div>
              <button id="usePrivKeyBtn" class="btn-tech w-full py-1.5 font-label-caps text-[11px] rounded-sm text-center border-secondary-fixed-dim text-secondary-fixed-dim hover:bg-secondary-fixed-dim hover:text-background transition-colors">APPLY PRIVATE KEY TO INPUT</button>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- Secure Share Inline -->
    <div class="bg-[#141416]/60 backdrop-blur-[20px] p-5 relative flex flex-col gap-4 border border-outline-variant rounded-sm panel-border group hover:border-primary/50 transition-colors">
      <div class="corner-tl corner-accent group-hover:border-primary"></div>
      <div class="corner-tr corner-accent group-hover:border-primary"></div>
      <div class="corner-bl corner-accent group-hover:border-primary"></div>
      <div class="corner-br corner-accent group-hover:border-primary"></div>
      
      <div class="flex items-center gap-2 mb-2">
        <span class="material-symbols-outlined text-primary">add_link</span>
        <h3 class="font-headline-md text-headline-md text-primary">SECURE SHARE</h3>
      </div>
      
      <p class="font-code-block text-[11px] text-on-surface-variant leading-relaxed">
        Generate a one-time burnable link containing your processed output. Expires in 24 hours.
      </p>

      <label class="flex items-center gap-3 cursor-pointer group/chk">
        <div class="relative flex items-center justify-center">
          <input type="checkbox" id="shareIncludeKey" class="peer appearance-none w-4 h-4 border border-outline-variant bg-black/40 checked:border-primary-fixed-dim checked:bg-primary/20 rounded-sm cursor-pointer transition-colors" />
          <span class="material-symbols-outlined text-[12px] text-primary-fixed-dim absolute opacity-0 peer-checked:opacity-100 pointer-events-none">check</span>
        </div>
        <span class="font-code-block text-[11px] text-on-surface group-hover/chk:text-primary transition-colors">Include Secret Key</span>
      </label>

      <button id="createLinkBtn" class="btn-tech w-full py-2 font-label-caps text-[11px] rounded-sm flex items-center justify-center gap-1 border-primary text-primary hover:bg-primary hover:text-background transition-colors">
        <span class="material-symbols-outlined text-[14px]">share</span> GENERATE SECURE LINK
      </button>

      <div id="shareResultWrapper" class="expand-wrapper mt-1">
        <div class="expand-inner">
          <div id="shareResultArea" class="flex flex-col gap-2 border-t border-outline-variant pt-3 opacity-0 transition-opacity duration-300">
        <span id="shareExpires" class="font-status-label text-[9px] text-primary-fixed-dim">EXPIRES: 24H (BURN AFTER READING)</span>
        <div class="flex gap-2">
          <input type="text" id="shareUrl" readonly class="flex-1 bg-black/60 border border-primary/30 p-2 font-code-block text-[11px] text-primary outline-none rounded-sm" />
          <button id="copyShareBtn" class="btn-tech px-3 font-label-caps text-[11px] rounded-sm border-primary text-primary hover:bg-primary hover:text-background transition-colors">COPY</button>
          </div>
        </div>
      </div>
    </div>
    
  </div>

  <!-- ── Bottom Panel: Execution Log ────────────────────────────────────── -->
  <div class="bg-[#141416]/60 backdrop-blur-[20px] rounded-sm border border-outline-variant panel-border overflow-hidden mt-2 flex flex-col transition-all duration-300 ease-in-out">
    <div class="bg-surface-container-low px-4 py-2 border-b border-outline-variant flex justify-between items-center">
      <div class="font-status-label text-status-label text-on-surface-variant flex items-center gap-2">
        <span class="material-symbols-outlined text-[14px]">receipt_long</span>
        EXECUTION_LOG
      </div>
      <div id="logTimer" class="font-status-label text-status-label text-primary-fixed-dim">
        T_ELAPSED: 0ms
      </div>
    </div>
    <div id="executionLog" class="p-4 font-code-block text-code-block text-sm flex flex-col gap-2 max-h-48 overflow-y-auto custom-scroll">
      <div class="flex gap-4 opacity-70">
        <span class="text-outline-variant w-24">00:00:00.000</span>
        <span class="text-secondary-fixed">INFO</span>
        <span class="text-on-surface">Initializing sequence handler...</span>
      </div>
      <div class="flex gap-4 opacity-70">
        <span class="text-outline-variant w-24">00:00:00.005</span>
        <span class="text-secondary-fixed">INFO</span>
        <span class="text-on-surface">Awaiting payload injection...</span>
      </div>
    </div>
    
    <!-- Retro progress bar -->
    <div class="h-1 flex w-full bg-surface-container-lowest mt-auto">
      <div id="retroProgress" class="h-full bg-primary-fixed-dim w-0 transition-all duration-300 flex"></div>
    </div>
  </div>

</div>

</div>
</div>


</div>

<script>
  // Custom Dropdowns Logic
  let activeCategory = 'hashing';
  let activeMethod = 'MD5';

  const catBtn = document.getElementById('catBtn') as HTMLButtonElement;
  const catMenu = document.getElementById('catMenu') as HTMLDivElement;
  const catLabel = document.getElementById('catLabel') as HTMLSpanElement;

  const metBtn = document.getElementById('metBtn') as HTMLButtonElement;
  const metMenu = document.getElementById('metMenu') as HTMLDivElement;
  const metLabel = document.getElementById('metLabel') as HTMLSpanElement;

  // Options map
  const methodMap: Record<string, string[]> = {
    hashing: ['MD5', 'SHA-256', 'SHA-512', 'SHA3-256', 'BLAKE2b', 'bcrypt'],
    encoding: ['Base64', 'Base32', 'Base85', 'URL', 'Hex', 'Binary', 'Morse'],
    encryption: ['AES-256', 'ChaCha20', 'Fernet', '3DES', 'ROT13', 'XOR'],
    formatting: ['JSON', 'JWT Decoder']
  };

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#catDropContainer')) catMenu.classList.add('hidden');
    if (!target.closest('#metDropContainer')) metMenu.classList.add('hidden');
  });

  catBtn.addEventListener('click', () => {
    catMenu.classList.toggle('hidden');
    metMenu.classList.add('hidden');
  });
  
  metBtn.addEventListener('click', () => {
    metMenu.classList.toggle('hidden');
    catMenu.classList.add('hidden');
  });

  document.querySelectorAll('.cat-opt').forEach(opt => {
    opt.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      activeCategory = el.dataset.val!;
      catLabel.textContent = el.textContent;
      catMenu.classList.add('hidden');
      initOptions();
    });
  });

  function initOptions() {
    const methods = methodMap[activeCategory] || [];
    metMenu.innerHTML = methods.map(m => `
      <button class="met-opt text-left px-4 py-3 font-code-block text-code-block text-on-surface hover:bg-primary/20 hover:text-primary transition-colors border-b border-outline-variant/30" data-val="${m}">
        ${m}
      </button>
    `).join('');
    
    if (methods.length > 0) {
      activeMethod = methods[0];
      metLabel.textContent = activeMethod;
    }
    
    document.querySelectorAll('.met-opt').forEach(opt => {
      opt.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        activeMethod = el.dataset.val!;
        metLabel.textContent = el.textContent;
        metMenu.classList.add('hidden');
        updateUIForMethod();
        processData();
      });
    });

    updateUIForMethod();
    processData();
  }

  // DOM Elements for Processor
  const sourceText       = document.getElementById('sourceText') as HTMLTextAreaElement;
  const charCount        = document.getElementById('charCount') as HTMLSpanElement;
  const secretKey        = document.getElementById('secretKey') as HTMLInputElement;
  const keyContainer     = document.getElementById('keyContainer') as HTMLDivElement;
  
  const resultsContainer = document.getElementById('resultsContainer') as HTMLDivElement;
  const apiStatus        = document.getElementById('apiStatus') as HTMLSpanElement;
  const outputFormatBadge= document.getElementById('outputFormatBadge') as HTMLSpanElement;
  
  const copyOutBtn       = document.getElementById('copyOutBtn') as HTMLButtonElement;
  const copyOutText      = document.getElementById('copyOutText') as HTMLSpanElement;
  
  const advancedToggle   = document.getElementById('advancedToggle') as HTMLButtonElement;
  const advancedWrapper  = document.getElementById('advancedWrapper') as HTMLDivElement;
  const advChevron       = document.getElementById('advChevron') as HTMLSpanElement;
  const aesAad           = document.getElementById('aesAad') as HTMLInputElement;

  const executionLog     = document.getElementById('executionLog') as HTMLDivElement;
  const logTimer         = document.getElementById('logTimer') as HTMLSpanElement;
  const retroProgress    = document.getElementById('retroProgress') as HTMLDivElement;

  // Share Vars
  const createLinkBtn    = document.getElementById('createLinkBtn') as HTMLButtonElement;
  const shareIncludeKey  = document.getElementById('shareIncludeKey') as HTMLInputElement;
  const shareResultArea  = document.getElementById('shareResultArea') as HTMLDivElement;
  const shareUrl         = document.getElementById('shareUrl') as HTMLInputElement;
  const copyShareBtn     = document.getElementById('copyShareBtn') as HTMLButtonElement;

  let debounceTimer: ReturnType<typeof setTimeout>;
  let currentController: AbortController | null = null;
  let lastData: any = null;
  let startTime = 0;

  // Advanced Options State
  let advancedEnabled = false;
  const advOpts = {
    aes_key_bits: 256,
    aes_output_format: 'base64',
    aes_aad: '',
    des_output_format: 'base64',
    xor_output_format: 'base64'
  };

  function updateUIForMethod() {
    const needsKey = ['AES-256', 'ChaCha20', 'Fernet', '3DES', 'XOR'].includes(activeMethod);
    const keyWrapper = document.getElementById('keyContainerWrapper') as HTMLDivElement;
    const keyInner = document.getElementById('keyContainerInner') as HTMLDivElement;

    if (needsKey) {
      keyWrapper.classList.add('is-open');
      keyInner.classList.remove('opacity-0');
      keyInner.classList.add('opacity-100');
    } else {
      keyWrapper.classList.remove('is-open');
      keyInner.classList.remove('opacity-100');
      keyInner.classList.add('opacity-0');
    }

    const hasAdvanced = ['AES-256', 'ChaCha20', '3DES', 'XOR'].includes(activeMethod);
    advancedToggle.style.visibility = hasAdvanced ? 'visible' : 'hidden';
    
    if (!hasAdvanced) {
      advancedEnabled = false;
      advancedWrapper.classList.remove('is-open');
      document.getElementById('advancedInner').classList.remove('opacity-100');
      document.getElementById('advancedInner').classList.add('opacity-0');
      advChevron.textContent = '+';
    } else if (advancedEnabled) {
      document.getElementById('advAesSettings').classList.toggle('hidden', !['AES-256', 'ChaCha20'].includes(activeMethod));
      document.getElementById('advDesSettings').classList.toggle('hidden', activeMethod !== '3DES');
      document.getElementById('advXorSettings').classList.toggle('hidden', activeMethod !== 'XOR');
    }
  }

  function formatTime(ms: number) {
    const d = new Date(ms);
    return d.toISOString().substring(11, 23);
  }

  function addLog(level: string, message: string, cssClass: string) {
    const time = formatTime(Date.now() - startTime);
    const logHtml = `
      <div class="flex gap-4 opacity-90 animate-[fadeIn_0.2s_ease-in]">
        <span class="text-outline-variant w-24">${time}</span>
        <span class="${cssClass}">${level}</span>
        <span class="text-on-surface">${message}</span>
      </div>
    `;
    executionLog.insertAdjacentHTML('beforeend', logHtml);
    executionLog.scrollTop = executionLog.scrollHeight;
  }

  sourceText.addEventListener('input', () => {
    charCount.textContent = `${sourceText.value.length} / 1000`;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(processData, 400);
  });

  secretKey.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(processData, 400);
  });

  // Advanced Toggle
  advancedToggle.addEventListener('click', () => {
    advancedEnabled = !advancedEnabled;
    advancedWrapper.classList.toggle('is-open', advancedEnabled);
    if (advancedEnabled) {
      document.getElementById('advancedInner').classList.remove('opacity-0');
      document.getElementById('advancedInner').classList.add('opacity-100');
    } else {
      document.getElementById('advancedInner').classList.remove('opacity-100');
      document.getElementById('advancedInner').classList.add('opacity-0');
    }
    advChevron.textContent = advancedEnabled ? '-' : '+';
    
    if (advancedEnabled) {
      document.getElementById('advAesSettings').classList.toggle('hidden', !['AES-256', 'ChaCha20'].includes(activeMethod));
      document.getElementById('advDesSettings').classList.toggle('hidden', activeMethod !== '3DES');
      document.getElementById('advXorSettings').classList.toggle('hidden', activeMethod !== 'XOR');
    } else {
      advOpts.aes_key_bits = 256;
      advOpts.aes_output_format = 'base64';
      advOpts.aes_aad = '';
      aesAad.value = '';
      advOpts.des_output_format = 'base64';
      advOpts.xor_output_format = 'base64';
      if (sourceText.value.trim()) processData();
    }
  });

  document.querySelectorAll('.adv-keybits').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.adv-keybits').forEach(b => {
        b.classList.remove('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
        b.classList.add('border-outline-variant', 'text-on-surface-variant');
      });
      btn.classList.add('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
      btn.classList.remove('border-outline-variant', 'text-on-surface-variant');
      advOpts.aes_key_bits = parseInt((btn as HTMLButtonElement).dataset.bits!);
      if (sourceText.value.trim()) processData();
    });
  });

  document.querySelectorAll('.adv-aes-fmt').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.adv-aes-fmt').forEach(b => {
        b.classList.remove('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
        b.classList.add('border-outline-variant', 'text-on-surface-variant');
      });
      btn.classList.add('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
      btn.classList.remove('border-outline-variant', 'text-on-surface-variant');
      advOpts.aes_output_format = (btn as HTMLButtonElement).dataset.fmt!;
      if (sourceText.value.trim()) processData();
    });
  });


  document.querySelectorAll('.adv-des-fmt').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.adv-des-fmt').forEach(b => {
        b.classList.remove('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
        b.classList.add('border-outline-variant', 'text-on-surface-variant');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
      target.classList.remove('border-outline-variant', 'text-on-surface-variant');
      advOpts.des_output_format = target.dataset.fmt!;
      if (sourceText.value.trim()) processData();
    });
  });

  document.querySelectorAll('.adv-xor-fmt').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.adv-xor-fmt').forEach(b => {
        b.classList.remove('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
        b.classList.add('border-outline-variant', 'text-on-surface-variant');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('active-adv', 'border-primary-fixed-dim', 'text-primary-fixed-dim');
      target.classList.remove('border-outline-variant', 'text-on-surface-variant');
      advOpts.xor_output_format = target.dataset.fmt!;
      if (sourceText.value.trim()) processData();
    });
  });

  aesAad.addEventListener('input', () => {
    advOpts.aes_aad = aesAad.value;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(processData, 400);
  });

  async function processData() {
    const text = sourceText.value;
    const key = secretKey.value;
    
    // Use globals for method
    const category = activeCategory;
    const method = activeMethod;

    executionLog.innerHTML = '';
    startTime = Date.now();
    addLog('INFO', 'Initializing sequence handler...', 'text-secondary-fixed');
    
    if (!text.trim()) {
      resultsContainer.innerHTML = '<span class="opacity-50">AWAITING INPUT...</span>';
      apiStatus.textContent = 'READY';
      apiStatus.className = 'text-primary-fixed-dim';
      retroProgress.style.width = '0%';
      addLog('WARN', 'Input buffer is empty. Standby.', 'text-error');
      return;
    }

    if (currentController) currentController.abort();
    currentController = new AbortController();

    apiStatus.textContent = 'PROCESSING...';
    apiStatus.className = 'text-secondary-fixed-dim animate-pulse';
    retroProgress.style.width = '30%';
    outputFormatBadge.textContent = method;

    addLog('EXEC', `Applying ${method} protocol...`, 'text-primary-fixed');

    try {
      const response = await fetch('/api/process', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text,
          key,
          category,
          method,
          advanced: advancedEnabled ? {
            aes_key_bits: advOpts.aes_key_bits,
            aes_aad: advOpts.aes_aad || null,
            aes_output_format: advOpts.aes_output_format,
            des_output_format: advOpts.des_output_format,
            xor_output_format: advOpts.xor_output_format,
          } : null,
        }),
        signal: currentController.signal,
      });

      const data = await response.json();
      retroProgress.style.width = '80%';
      
      if (!response.ok) throw new Error(data.detail || 'API Error');

      lastData = data;
      renderResults();
      apiStatus.textContent = 'SUCCESS';
      apiStatus.className = 'text-primary-fixed-dim';
      retroProgress.style.width = '100%';
      
      const elapsed = Date.now() - startTime;
      logTimer.textContent = `T_ELAPSED: ${elapsed}ms`;
      addLog('DONE', 'Process completed successfully.', 'text-primary');

    } catch (error: any) {
      if (error.name === 'AbortError') return;
      apiStatus.textContent = 'ERROR';
      apiStatus.className = 'text-error font-bold';
      resultsContainer.innerHTML = `<span class="text-error font-bold">[${error.message}]</span>`;
      retroProgress.style.width = '0%';
      addLog('ERR', error.message, 'text-error');
    }
  }

  function renderResults() {
    if (!lastData || !lastData.result) return;
    
    let formattedResult = lastData.result;
    
    if (typeof formattedResult === 'object') {
       formattedResult = JSON.stringify(formattedResult, null, 2);
    }
    
    formattedResult = formattedResult
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br>');

    resultsContainer.innerHTML = formattedResult;
  }

  copyOutBtn.addEventListener('click', () => {
    if (!lastData?.result) return;
    const textToCopy = typeof lastData.result === 'string' ? lastData.result : JSON.stringify(lastData.result, null, 2);
    
    navigator.clipboard.writeText(textToCopy)
      .then(() => {
        const origHtml = copyOutBtn.innerHTML;
        copyOutBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span> <span id="copyOutText">COPIED</span>';
        copyOutBtn.classList.add('bg-primary', 'text-background');
        setTimeout(() => {
          copyOutBtn.innerHTML = origHtml;
          copyOutBtn.classList.remove('bg-primary', 'text-background');
        }, 2000);
      })
      .catch(() => alert('Copy failed'));
  });



  createLinkBtn.addEventListener('click', async () => {
    if (!lastData?.result) {
      alert('Process data first to share results.');
      return;
    }
    createLinkBtn.innerHTML = '<span class="material-symbols-outlined text-[14px] animate-spin">refresh</span> GENERATING...';
    createLinkBtn.disabled = true;

    try {
      const payload = {
        data: lastData.result,
        secret_key: shareIncludeKey.checked ? secretKey.value : undefined,
        method: activeMethod
      };

      const res = await fetch('/api/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      if (!res.ok) throw new Error('Failed to generate link');
      const data = await res.json();
      
      shareUrl.value = `${window.location.origin}/share/${data.id}`;
      document.getElementById('shareResultWrapper').classList.add('is-open');
      shareResultArea.classList.remove('opacity-0');
      shareResultArea.classList.add('opacity-100');
    } catch (e: any) {
      alert(e.message);
    } finally {
      createLinkBtn.innerHTML = '<span class="material-symbols-outlined text-[14px]">share</span> GENERATE SECURE LINK';
      createLinkBtn.disabled = false;
    }
  });

  copyShareBtn.addEventListener('click', () => {
    shareUrl.select();
    navigator.clipboard.writeText(shareUrl.value);
    const orig = copyShareBtn.textContent;
    copyShareBtn.textContent = 'COPIED';
    copyShareBtn.classList.add('bg-primary', 'text-background');
    setTimeout(() => { 
      copyShareBtn.textContent = orig;
      copyShareBtn.classList.remove('bg-primary', 'text-background');
    }, 2000);
  });


  // KeyGen Logic

  let activeGenType = 'AES-256';
  let activeGenLength = '256';

  const genTypeBtn = document.getElementById('genTypeBtn') as HTMLButtonElement;
  const genTypeMenu = document.getElementById('genTypeMenu') as HTMLDivElement;
  const genTypeLabel = document.getElementById('genTypeLabel') as HTMLSpanElement;

  const genLenBtn = document.getElementById('genLenBtn') as HTMLButtonElement;
  const genLenMenu = document.getElementById('genLenMenu') as HTMLDivElement;
  const genLenLabel = document.getElementById('genLenLabel') as HTMLSpanElement;

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#genTypeDropContainer')) {
      genTypeMenu.classList.add('hidden');
      genTypeMenu.classList.remove('flex');
    }
    if (!target.closest('#genLenDropContainer')) {
      genLenMenu.classList.add('hidden');
      genLenMenu.classList.remove('flex');
    }
  });

  genTypeBtn.addEventListener('click', () => {
    const isHidden = genTypeMenu.classList.contains('hidden');
    genTypeMenu.classList.toggle('hidden', !isHidden);
    genTypeMenu.classList.toggle('flex', isHidden);
    genLenMenu.classList.add('hidden');
    genLenMenu.classList.remove('flex');
  });

  genLenBtn.addEventListener('click', () => {
    const isHidden = genLenMenu.classList.contains('hidden');
    genLenMenu.classList.toggle('hidden', !isHidden);
    genLenMenu.classList.toggle('flex', isHidden);
    genTypeMenu.classList.add('hidden');
    genTypeMenu.classList.remove('flex');
  });

  document.querySelectorAll('.type-opt').forEach(opt => {
    opt.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      activeGenType = el.dataset.val!;
      genTypeLabel.textContent = el.textContent;
      genTypeMenu.classList.add('hidden');
      genTypeMenu.classList.remove('flex');
    });
  });

  document.querySelectorAll('.len-opt').forEach(opt => {
    opt.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      activeGenLength = el.dataset.val!;
      genLenLabel.textContent = el.textContent;
      genLenMenu.classList.add('hidden');
      genLenMenu.classList.remove('flex');
    });
  });

  // KeyGen Variables
  const doGenerateKeyBtn = document.getElementById('doGenerateKeyBtn') as HTMLButtonElement;
  const keyGenResultArea = document.getElementById('keyGenResultArea') as HTMLDivElement;
  const keyGenOutput = document.getElementById('keyGenOutput') as HTMLInputElement;
  const copyGenKeyBtn = document.getElementById('copyGenKeyBtn') as HTMLButtonElement;
  const useGenKeyBtn = document.getElementById('useGenKeyBtn') as HTMLButtonElement;



  doGenerateKeyBtn.addEventListener('click', async () => {
    const alg = activeGenType;
    const len = activeGenLength;
    document.getElementById('keyGenResultWrapper').classList.remove('is-open');
    keyGenResultArea.classList.remove('opacity-100');
    keyGenResultArea.classList.add('opacity-0');
    doGenerateKeyBtn.innerHTML = '<span class="material-symbols-outlined text-[14px] animate-spin">refresh</span> GENERATING...';
    
    try {
      const res = await fetch('/api/generate-key', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ algorithm: alg, length: parseInt(len) })
      });
      const data = await res.json();
      
      const singleArea = document.getElementById('singleKeyArea') as HTMLDivElement;
      const pairArea = document.getElementById('keyPairArea') as HTMLDivElement;

      if (data.is_pair) {
        singleArea.classList.add('hidden');
        pairArea.classList.remove('hidden');
        pairArea.classList.add('flex');
        
        (document.getElementById('pubKeyOutput') as HTMLTextAreaElement).value = data.public_key;
        (document.getElementById('privKeyOutput') as HTMLTextAreaElement).value = data.private_key;
      } else {
        pairArea.classList.add('hidden');
        pairArea.classList.remove('flex');
        singleArea.classList.remove('hidden');
        singleArea.classList.add('flex');
        
        keyGenOutput.value = data.key;
      }

      document.getElementById('keyGenResultWrapper').classList.add('is-open');
      keyGenResultArea.classList.remove('opacity-0');
      keyGenResultArea.classList.add('opacity-100');
    } catch(e) {
      alert('Error generating key');
    } finally {
      doGenerateKeyBtn.innerHTML = '<span class="material-symbols-outlined text-[14px]">refresh</span> GENERATE';
    }
  });

  copyGenKeyBtn.addEventListener('click', () => {
    keyGenOutput.select();
    navigator.clipboard.writeText(keyGenOutput.value);
    const orig = copyGenKeyBtn.textContent;
    copyGenKeyBtn.textContent = 'COPIED';
    setTimeout(() => { copyGenKeyBtn.textContent = orig; }, 2000);
  });

  useGenKeyBtn.addEventListener('click', () => {
    secretKey.value = keyGenOutput.value;
    if (sourceText.value.trim()) processData();
  });

  
  const copyPubKeyBtn = document.getElementById('copyPubKeyBtn') as HTMLButtonElement;
  const copyPrivKeyBtn = document.getElementById('copyPrivKeyBtn') as HTMLButtonElement;
  const usePrivKeyBtn = document.getElementById('usePrivKeyBtn') as HTMLButtonElement;
  const pubKeyOutput = document.getElementById('pubKeyOutput') as HTMLTextAreaElement;
  const privKeyOutput = document.getElementById('privKeyOutput') as HTMLTextAreaElement;

  copyPubKeyBtn?.addEventListener('click', () => {
    pubKeyOutput.select();
    navigator.clipboard.writeText(pubKeyOutput.value);
    const orig = copyPubKeyBtn.textContent;
    copyPubKeyBtn.textContent = '[COPIED]';
    setTimeout(() => { copyPubKeyBtn.textContent = orig; }, 2000);
  });

  copyPrivKeyBtn?.addEventListener('click', () => {
    privKeyOutput.select();
    navigator.clipboard.writeText(privKeyOutput.value);
    const orig = copyPrivKeyBtn.textContent;
    copyPrivKeyBtn.textContent = '[COPIED]';
    setTimeout(() => { copyPrivKeyBtn.textContent = orig; }, 2000);
  });

  usePrivKeyBtn?.addEventListener('click', () => {
    secretKey.value = privKeyOutput.value;
    if (sourceText.value.trim()) processData();
  });

  // Initialize
  initOptions();

</script>
<style>
  .expand-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-in-out;
  }
  .expand-wrapper.is-open {
    grid-template-rows: 1fr;
  }
  .expand-inner {
    overflow: hidden;
  }

  .animate-slide-down { animation: slideDown 0.3s ease-out forwards; }
  .animate-slide-up { animation: slideUp 0.2s ease-out forwards; }
  .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
  
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .custom-scroll::-webkit-scrollbar { width: 6px; }
  .custom-scroll::-webkit-scrollbar-track { background: transparent; }
  .custom-scroll::-webkit-scrollbar-thumb { background: var(--color-outline-variant); border-radius: 2px; }
  .custom-scroll:hover::-webkit-scrollbar-thumb { background: var(--color-primary-fixed-dim); }
</style>
