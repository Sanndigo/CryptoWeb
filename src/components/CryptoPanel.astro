---
// CryptoPanel.astro
---
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start font-sans">
  <!-- Sidebar Menu (Left) -->
  <div class="lg:col-span-3 tech-panel flex flex-col space-y-1 sticky top-24 max-h-[80vh] overflow-y-auto custom-scroll">
    <h3 class="text-xs text-pure-white font-bold tracking-widest uppercase mb-2 border-b border-dark-gray pb-2">Categories</h3>
    
    <button class="category-btn text-left text-sm px-3 py-2 border border-transparent transition-colors active text-neon-green border-neon-green bg-dark-gray/20" data-category="all">
      [ All Modes ]
    </button>
    
    <div class="menu-group">
      <button class="category-btn flex justify-between items-center w-full text-left text-sm px-3 py-2 text-light-gray hover:text-neon-green border border-transparent transition-colors" data-category="hashing">
        <span>> Hashing</span>
        <span class="text-xs chevron font-mono">+</span>
      </button>
      <div class="accordion-wrapper">
        <div class="accordion-inner">
          <div class="method-list flex-col pl-4 border-l border-dark-gray ml-3 mt-1 mb-2 space-y-1 bg-[#050505] py-2 pr-2">
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="MD5">MD5</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="SHA-256">SHA-256</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="SHA-512">SHA-512</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="bcrypt">bcrypt</button>
          </div>
        </div>
      </div>
    </div>

    <div class="menu-group">
      <button class="category-btn flex justify-between items-center w-full text-left text-sm px-3 py-2 text-light-gray hover:text-neon-green border border-transparent transition-colors" data-category="encoding">
        <span>> Encoding</span>
        <span class="text-xs chevron font-mono">+</span>
      </button>
      <div class="accordion-wrapper">
        <div class="accordion-inner">
          <div class="method-list flex-col pl-4 border-l border-dark-gray ml-3 mt-1 mb-2 space-y-1 bg-[#050505] py-2 pr-2">
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="Base64">Base64</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="URL">URL</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="Hex">Hex</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="Binary">Binary</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="Morse">Morse</button>
          </div>
        </div>
      </div>
    </div>

    <div class="menu-group">
      <button class="category-btn flex justify-between items-center w-full text-left text-sm px-3 py-2 text-light-gray hover:text-neon-green border border-transparent transition-colors" data-category="encryption">
        <span>> Encryption</span>
        <span class="text-xs chevron font-mono">+</span>
      </button>
      <div class="accordion-wrapper">
        <div class="accordion-inner">
          <div class="method-list flex-col pl-4 border-l border-dark-gray ml-3 mt-1 mb-2 space-y-1 bg-[#050505] py-2 pr-2">
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="AES-256">AES-256</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="DES">DES</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="ROT13">ROT13</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="XOR">XOR</button>
          </div>
        </div>
      </div>
    </div>

    <div class="menu-group">
      <button class="category-btn flex justify-between items-center w-full text-left text-sm px-3 py-2 text-light-gray hover:text-neon-green border border-transparent transition-colors" data-category="formatting">
        <span>> Formatting</span>
        <span class="text-xs chevron font-mono">+</span>
      </button>
      <div class="accordion-wrapper">
        <div class="accordion-inner">
          <div class="method-list flex-col pl-4 border-l border-dark-gray ml-3 mt-1 mb-2 space-y-1 bg-[#050505] py-2 pr-2">
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="JSON">JSON</button>
            <button class="method-btn w-full text-left text-xs text-light-gray hover:text-pure-white transition-colors py-1 px-2" data-method="JWT Decoder">JWT Decoder</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content (Middle + Right) -->
  <div class="lg:col-span-9 flex flex-col gap-6">
    <!-- Input Section -->
    <div class="tech-panel flex flex-col">
      <div class="flex justify-between items-end mb-2">
        <label for="sourceText" class="tech-label !mb-0">Payload Data</label>
        <span id="charCount" class="text-[10px] font-mono text-light-gray tracking-widest">0 / 1000</span>
      </div>
      <textarea 
        id="sourceText" 
        class="tech-input w-full min-h-[160px] resize-y" 
        placeholder="Enter payload..."
        maxlength="1000"></textarea>
      
      <div class="mt-4">
        <label for="secretKey" class="tech-label">Secret Key (for AES/DES/XOR)</label>
        <input 
          type="text" 
          id="secretKey" 
          class="tech-input h-10 w-full md:w-1/2" 
          placeholder="Optional symmetric key..." 
          maxlength="256" />
      </div>

      <div class="mt-4 pt-4 border-t border-dark-gray text-xs text-light-gray font-mono flex items-center justify-between">
        <span>Status: <span id="apiStatus" class="text-neon-green font-bold">READY</span></span>
      </div>
    </div>

    <!-- Output Section -->
    <div class="tech-panel min-h-[400px]">
      <div class="space-y-6" id="resultsContainer">
        <div class="text-center text-light-gray font-mono py-10 opacity-50 flex flex-col items-center justify-center h-full">
          <span>AWAITING INPUT...</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const sourceText = document.getElementById('sourceText') as HTMLTextAreaElement;
  const secretKey = document.getElementById('secretKey') as HTMLInputElement;
  const resultsContainer = document.getElementById('resultsContainer') as HTMLDivElement;
  const apiStatus = document.getElementById('apiStatus') as HTMLSpanElement;
  const charCount = document.getElementById('charCount') as HTMLSpanElement;
  
  const categoryBtns = document.querySelectorAll('.category-btn');
  const methodBtns = document.querySelectorAll('.method-btn');

  let debounceTimer: ReturnType<typeof setTimeout>;
  let lastData: any = null;
  let selectedCategory = 'all';
  let selectedMethod = 'all';

  async function processData() {
    const text = sourceText.value;
    const key = secretKey.value;

    if (!text.trim()) {
      lastData = null;
      resultsContainer.innerHTML = '<div class="text-center text-light-gray font-mono py-10 opacity-50">AWAITING INPUT...</div>';
      apiStatus.textContent = 'READY';
      apiStatus.className = 'text-neon-green font-bold';
      return;
    }

    apiStatus.textContent = 'PROCESSING...';
    apiStatus.className = 'text-yellow-400 font-bold animate-pulse';

    try {
      const response = await fetch(`/api/process`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ text, key })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.detail || 'API Error');
      }

      lastData = data;
      renderResults();
      apiStatus.textContent = 'SUCCESS';
      apiStatus.className = 'text-neon-green font-bold';
    } catch (error: any) {
      console.error(error);
      apiStatus.textContent = 'ERROR';
      apiStatus.className = 'text-red-500 font-bold';
      resultsContainer.innerHTML = `<div class="text-red-500 font-mono py-4 px-4 bg-red-500/10 border border-red-500/30">${escapeHtml(error.message || 'Failed to communicate with backend.')}</div>`;
    }
  }

  function renderResults() {
    if (!lastData || Object.keys(lastData).length === 0) return;
    
    let html = '';
    let counter = 0; // To generate unique IDs
    
    for (const [category, items] of Object.entries(lastData)) {
      if (selectedCategory !== 'all' && selectedCategory !== category) continue;

      let methodsHtml = '';
      for (const [method, result] of Object.entries(items as Record<string, any>)) {
        if (selectedMethod !== 'all' && selectedMethod !== method) continue;
        counter++;

        // Determine if it's a simple string or a dict (Encode/Decode)
        if (typeof result === 'string') {
          methodsHtml += `
            <div class="bg-black-bg border border-dark-gray p-4 hover:border-neon-green/50 transition-all card-container">
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
                <span class="text-xs font-bold text-pure-white bg-dark-gray/50 px-3 py-1">${method}</span>
                <button class="copy-btn shrink-0 text-xs text-pure-white font-bold border border-dark-gray hover:border-neon-green hover:text-neon-green hover:bg-neon-green/10 bg-dark-gray/20 px-4 py-1.5 transition-all active:scale-95">
                  COPY
                </button>
              </div>
              <div class="result-text font-mono text-sm text-light-gray break-all max-h-40 overflow-y-auto pr-2 custom-scroll whitespace-pre-wrap">${escapeHtml(result)}</div>
            </div>
          `;
        } else {
          // It's an object with multiple modes (e.g., Encode/Decode)
          const keys = Object.keys(result);
          const key1 = keys[0];
          const key2 = keys[1];
          const val1 = result[key1];
          const val2 = result[key2];

          methodsHtml += `
            <div class="bg-black-bg border border-dark-gray p-4 hover:border-neon-green/50 transition-all card-container">
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-xs font-bold text-pure-white bg-dark-gray/50 px-3 py-1">${method}</span>
                  <div class="flex bg-black-bg border border-dark-gray rounded-sm p-0.5">
                    <button class="pane-switch px-3 py-1 text-[10px] uppercase font-bold tracking-wider transition-colors active text-neon-green bg-dark-gray" data-target="pane1-${counter}">${key1}</button>
                    <button class="pane-switch px-3 py-1 text-[10px] uppercase font-bold tracking-wider transition-colors text-light-gray hover:text-pure-white" data-target="pane2-${counter}">${key2}</button>
                  </div>
                </div>
                <button class="copy-btn shrink-0 text-xs text-pure-white font-bold border border-dark-gray hover:border-neon-green hover:text-neon-green hover:bg-neon-green/10 bg-dark-gray/20 px-4 py-1.5 transition-all active:scale-95">
                  COPY
                </button>
              </div>
              
              <div class="relative">
                <div id="pane1-${counter}" class="result-text pane block font-mono text-sm text-light-gray break-all max-h-40 overflow-y-auto pr-2 custom-scroll whitespace-pre-wrap">${escapeHtml(val1)}</div>
                <div id="pane2-${counter}" class="result-text pane hidden font-mono text-sm text-light-gray break-all max-h-40 overflow-y-auto pr-2 custom-scroll whitespace-pre-wrap">${escapeHtml(val2)}</div>
              </div>
            </div>
          `;
        }
      }
      
      if (methodsHtml) {
        html += `<div class="mb-8">
          <h3 class="text-neon-green text-sm font-bold tracking-widest uppercase mb-4 border-b border-neon-green/30 pb-2">${category}</h3>
          <div class="grid gap-4 md:grid-cols-2">${methodsHtml}</div>
        </div>`;
      }
    }

    if (html === '') {
      html = '<div class="text-center text-light-gray font-mono py-10 opacity-50">No results found for this selection.</div>';
    }

    resultsContainer.innerHTML = html;

    attachDynamicListeners();
  }

  function attachDynamicListeners() {
    // Copy buttons
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const card = target.closest('.card-container');
        if (!card) return;

        // Find the currently visible result text
        let visiblePane = Array.from(card.querySelectorAll('.result-text')).find(el => !el.classList.contains('hidden'));
        
        if (visiblePane && visiblePane.textContent) {
          navigator.clipboard.writeText(visiblePane.textContent);
          const originalText = target.innerText;
          target.innerText = 'COPIED!';
          target.classList.add('border-neon-green', 'text-neon-green', 'bg-neon-green/20');
          setTimeout(() => {
            target.innerText = originalText;
            target.classList.remove('border-neon-green', 'text-neon-green', 'bg-neon-green/20');
          }, 2000);
        }
      });
    });

    // Pane switches
    document.querySelectorAll('.pane-switch').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const parent = target.parentElement;
        const card = target.closest('.card-container');
        if (!parent || !card) return;

        // Reset sibling buttons
        parent.querySelectorAll('.pane-switch').forEach(b => {
          b.classList.remove('active', 'text-neon-green', 'bg-dark-gray');
          b.classList.add('text-light-gray');
        });

        // Activate clicked button
        target.classList.add('active', 'text-neon-green', 'bg-dark-gray');
        target.classList.remove('text-light-gray');

        // Hide all panes, show target
        card.querySelectorAll('.pane').forEach(p => p.classList.add('hidden'));
        const paneId = target.getAttribute('data-target');
        const targetPane = document.getElementById(paneId!);
        if (targetPane) targetPane.classList.remove('hidden');
      });
    });
  }

  function escapeHtml(unsafe: string) {
    return (unsafe || "").toString()
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
  }

  // Handle Category Selection (Accordion & Filtering)
  categoryBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const cat = target.getAttribute('data-category') || 'all';
      
      if (cat === 'all') {
        // Close all accordions
        document.querySelectorAll('.accordion-wrapper').forEach(w => w.classList.remove('open'));
        document.querySelectorAll('.chevron').forEach(icon => icon.textContent = '+');
        selectedCategory = 'all';
        selectedMethod = 'all';
      } else {
        const group = target.closest('.menu-group');
        if (group) {
          const wrapper = group.querySelector('.accordion-wrapper');
          const chevron = target.querySelector('.chevron');
          
          if (selectedCategory === cat && wrapper?.classList.contains('open')) {
             wrapper.classList.remove('open');
             if(chevron) chevron.textContent = '+';
             selectedCategory = 'all';
             selectedMethod = 'all';
          } else {
            // Close others
            document.querySelectorAll('.accordion-wrapper').forEach(w => w.classList.remove('open'));
            document.querySelectorAll('.chevron').forEach(icon => icon.textContent = '+');
            
            wrapper?.classList.add('open');
            if(chevron) chevron.textContent = '-';
            selectedCategory = cat;
            selectedMethod = 'all';
          }
        }
      }

      updateMenuUI(target);
      if (lastData) renderResults();
    });
  });

  // Handle Specific Method Selection
  methodBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = e.currentTarget as HTMLButtonElement;
      
      selectedMethod = target.getAttribute('data-method') || 'all';
      
      methodBtns.forEach(b => {
        b.classList.remove('text-neon-green', 'font-bold', 'bg-dark-gray/40');
        b.classList.add('text-light-gray');
      });
      target.classList.remove('text-light-gray');
      target.classList.add('text-neon-green', 'font-bold', 'bg-dark-gray/40');

      if (lastData) renderResults();
    });
  });

  function updateMenuUI(activeBtn: HTMLButtonElement) {
    categoryBtns.forEach(b => {
      b.classList.remove('active', 'text-neon-green', 'border-neon-green', 'bg-dark-gray/20');
      if (b.getAttribute('data-category') !== 'all') {
        b.classList.add('text-light-gray');
      }
    });
    activeBtn.classList.add('active', 'text-neon-green', 'border-neon-green', 'bg-dark-gray/20');
    activeBtn.classList.remove('text-light-gray');

    if (selectedMethod === 'all') {
      methodBtns.forEach(b => {
        b.classList.remove('text-neon-green', 'font-bold', 'bg-dark-gray/40');
        b.classList.add('text-light-gray');
      });
    }
  }

  // Event Listeners
  const onInput = () => {
    // Update char counter
    const len = sourceText.value.length;
    charCount.textContent = `${len} / 1000`;
    if (len >= 1000) {
      charCount.classList.add('text-red-500');
      charCount.classList.remove('text-light-gray');
    } else {
      charCount.classList.remove('text-red-500');
      charCount.classList.add('text-light-gray');
    }

    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(processData, 300);
  };

  sourceText.addEventListener('input', onInput);
  secretKey.addEventListener('input', onInput);

</script>

<style>
  .custom-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scroll::-webkit-scrollbar-track {
    background: var(--color-black-bg);
  }
  .custom-scroll::-webkit-scrollbar-thumb {
    background: var(--color-dark-gray);
  }
  .custom-scroll:hover::-webkit-scrollbar-thumb {
    background: var(--color-neon-green);
  }

  /* Smooth Accordion CSS */
  .accordion-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }
  .accordion-wrapper.open {
    grid-template-rows: 1fr;
  }
  .accordion-inner {
    overflow: hidden;
  }
</style>
