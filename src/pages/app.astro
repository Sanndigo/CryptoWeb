---
import Layout from '../layouts/Layout.astro';
import CryptoPanel from '../components/CryptoPanel.astro';
---

<Layout title="webcrypt60 | Advanced Cryptography Suite">
  <div class="p-4 md:p-8 lg:p-12 overflow-y-auto w-full relative pb-24">
    <div class="mb-8 border-l-2 border-primary pl-4 flex flex-col gap-2">
      <h2 class="font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-surface tracking-tighter mb-2">UNIVERSAL TERMINAL</h2>
      <div class="flex items-center gap-3 text-secondary-fixed-dim font-code-block text-code-block mb-4">
        <span class="material-symbols-outlined text-[16px]">terminal</span>
        <span>AWAITING PAYLOAD INJECTION</span>
      </div>
      <p class="font-code-block text-code-block text-on-surface-variant max-w-2xl">
        Enter your payload to selectively encode, decode, hash, and encrypt. Enter an optional secret key for symmetric protocols.
      </p>
    </div>

    <CryptoPanel />
  </div>
</Layout>
