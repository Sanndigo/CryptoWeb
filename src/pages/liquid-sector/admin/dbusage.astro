---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="CryptoWeb - Admin Console">
  <main class="min-h-screen bg-black-bg text-pure-white p-4 sm:p-8 font-sans flex flex-col relative">
    
    <!-- Background Accents -->
    <div class="fixed top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500/0 via-red-500 to-red-500/0 opacity-50"></div>
    
    <div class="w-full max-w-6xl mx-auto flex-1 flex flex-col">
      <div class="flex items-center justify-between mb-6 border-b border-dark-gray pb-4">
        <div>
          <h1 class="text-2xl font-bold tracking-widest text-pure-white uppercase flex items-center gap-3">
            <span class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></span>
            SYSTEM ADMIN CONSOLE
          </h1>
          <p class="text-xs font-mono text-light-gray mt-1">Live server event streaming & monitoring</p>
        </div>
        <a href="/" class="text-xs font-bold px-4 py-2 border border-dark-gray text-light-gray hover:border-neon-green hover:text-neon-green transition-all">EXIT TO APP</a>
      </div>

      <div class="flex gap-4 mb-4 items-center">
        <input type="password" id="adminPass" placeholder="Enter Admin Password..." 
               class="tech-input h-10 px-4 font-mono text-xs w-64 focus:outline-none" />
        <button id="fetchLogsBtn" class="h-10 px-6 border border-neon-green text-neon-green text-xs font-bold tracking-widest hover:bg-neon-green/10 transition-all active:scale-95">
          FETCH LOGS
        </button>
        <button id="clearLogsBtn" class="h-10 px-6 border border-red-500 text-red-500 text-xs font-bold tracking-widest hover:bg-red-500/10 transition-all active:scale-95 ml-auto">
          PURGE LOGS
        </button>
      </div>

      <div id="logContainer" class="flex-1 bg-black-bg/80 border border-dark-gray p-4 font-mono text-[11px] sm:text-xs text-light-gray overflow-y-auto relative h-[60vh] shadow-[inset_0_0_20px_rgba(0,0,0,0.8)]">
        <div id="loadingOverlay" class="hidden absolute inset-0 bg-black-bg/80 flex items-center justify-center">
          <p class="text-neon-green animate-pulse">CONNECTING TO SECURE SERVER...</p>
        </div>
        <pre id="logOutput" class="whitespace-pre-wrap break-all">Awaiting authentication...</pre>
      </div>
    </div>
  </main>
</Layout>

<script>
  const adminPass    = document.getElementById('adminPass') as HTMLInputElement;
  const fetchLogsBtn = document.getElementById('fetchLogsBtn');
  const clearLogsBtn = document.getElementById('clearLogsBtn');
  const logOutput    = document.getElementById('logOutput');
  const logContainer = document.getElementById('logContainer');
  const loadingOverlay = document.getElementById('loadingOverlay');

  async function fetchLogs() {
    if (!adminPass.value) {
      logOutput!.innerHTML = '<span class="text-red-500">Error: Password required.</span>';
      return;
    }
    
    loadingOverlay?.classList.remove('hidden');
    try {
      const res = await fetch(`/api/liquid-sector/admin/logs?password=${encodeURIComponent(adminPass.value)}`);
      if (!res.ok) throw new Error(res.status === 401 ? 'Unauthorized Access' : 'Server Error');
      const data = await res.json();
      
      if (!data.logs) {
        logOutput!.innerHTML = '<span class="text-light-gray">Log file is empty.</span>';
      } else {
        const escapeHtml = (unsafe: string) => {
          return unsafe.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        };
        let safeLogs = escapeHtml(data.logs);
        // Colorize log levels for better readability
        let formattedLogs = safeLogs
          .replace(/\[INFO\]/g, '<span class="text-neon-green font-bold">[INFO]</span>')
          .replace(/\[WARNING\]/g, '<span class="text-yellow-400 font-bold">[WARNING]</span>')
          .replace(/\[ERROR\]/g, '<span class="text-red-500 font-bold">[ERROR]</span>');
        logOutput!.innerHTML = formattedLogs;
      }
      
      // Auto-scroll to bottom
      logContainer!.scrollTop = logContainer!.scrollHeight;
    } catch (e: any) {
      logOutput!.innerHTML = `<span class="text-red-500">Error: ${e.message}</span>`;
    } finally {
      loadingOverlay?.classList.add('hidden');
    }
  }

  async function clearLogs() {
    if (!adminPass.value) return;
    if (!confirm('Are you sure you want to permanently delete all server logs?')) return;
    
    try {
      const res = await fetch(`/api/liquid-sector/admin/logs?password=${encodeURIComponent(adminPass.value)}`, {
        method: 'DELETE'
      });
      if (!res.ok) throw new Error(res.status === 401 ? 'Unauthorized Access' : 'Server Error');
      logOutput!.innerHTML = '<span class="text-neon-green">Logs purged successfully.</span>';
    } catch (e: any) {
      logOutput!.innerHTML = `<span class="text-red-500">Error: ${e.message}</span>`;
    }
  }

  fetchLogsBtn?.addEventListener('click', fetchLogs);
  clearLogsBtn?.addEventListener('click', clearLogs);
  adminPass?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') fetchLogs();
  });
</script>
