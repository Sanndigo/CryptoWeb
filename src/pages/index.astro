---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="CryptoWeb - Secure Data Processing, Encryption, and Key Sharing"
  description="CryptoWeb by WebTech60 is a robust online toolkit for developers. Perform MD5, SHA-256 hashing, AES-256 and 3DES encryption, Base64/Hex encoding, and secure one-time key sharing instantly in your browser."
>
  <main class="w-full max-w-6xl mx-auto p-4 sm:p-8 flex flex-col gap-16 pb-20 mt-8 relative z-10">
    
    <!-- Hero Section -->
    <section class="flex flex-col items-center text-center gap-6 py-12 md:py-20">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-headline-xl tracking-tighter text-on-surface leading-tight glitch-hover">
        SECURE <span class="text-primary glow-effect px-2">ENCRYPTION</span> SUITE
      </h1>
      <p class="text-on-surface-variant max-w-2xl font-code-block text-code-block leading-relaxed mt-4">
        CryptoWeb is an advanced toolkit for cryptographic engineers. Instantly hash, encrypt, encode, and securely share your sensitive data via one-time burnable links. Zero logs. Zero compromise.
      </p>
      <div class="flex gap-4 mt-8 flex-wrap justify-center">
        <a href="/app" class="btn-tech font-label-caps text-label-caps px-8 py-4 flex items-center gap-2 rounded-sm">
          <span class="material-symbols-outlined">terminal</span>
          INITIATE TERMINAL
        </a>
        <a href="/handbook" class="border border-outline-variant text-on-surface-variant hover:border-secondary-fixed-dim hover:text-secondary-fixed-dim transition-all duration-200 font-label-caps text-label-caps px-8 py-4 flex items-center gap-2 rounded-sm">
          <span class="material-symbols-outlined">menu_book</span>
          DOCUMENTATION
        </a>
      </div>
    </section>

    <!-- SEO & Technologies Section -->
    <section class="bg-[#141416]/60 backdrop-blur-[20px] panel-border p-8 relative rounded-sm group hover:border-primary/50 transition-colors">
      <div class="corner-tl corner-accent group-hover:border-primary"></div><div class="corner-tr corner-accent group-hover:border-primary"></div><div class="corner-bl corner-accent group-hover:border-primary"></div><div class="corner-br corner-accent group-hover:border-primary"></div>
      
      <div class="flex items-center gap-3 mb-8">
        <span class="material-symbols-outlined text-primary text-[24px]">account_tree</span>
        <h2 class="font-headline-md text-headline-md tracking-widest text-on-surface">SUPPORTED PROTOCOLS</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="flex flex-col gap-2">
          <h3 class="text-primary font-label-caps text-label-caps border-b border-outline-variant pb-2">HASHING</h3>
          <ul class="font-code-block text-code-block text-on-surface-variant space-y-2 mt-2 list-disc pl-4">
            <li>SHA-256 / SHA-512</li>
            <li>SHA3-256 / BLAKE2b</li>
            <li>bcrypt (Adaptive)</li>
            <li>MD5 (Legacy)</li>
          </ul>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-secondary-fixed-dim font-label-caps text-label-caps border-b border-outline-variant pb-2">ENCRYPTION</h3>
          <ul class="font-code-block text-code-block text-on-surface-variant space-y-2 mt-2 list-disc pl-4">
            <li>AES-256 (GCM)</li>
            <li>ChaCha20-Poly1305</li>
            <li>Fernet</li>
            <li>3DES / XOR</li>
          </ul>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-on-surface font-label-caps text-label-caps border-b border-outline-variant pb-2">ENCODING</h3>
          <ul class="font-code-block text-code-block text-on-surface-variant space-y-2 mt-2 list-disc pl-4">
            <li>Base64 / Base32</li>
            <li>Base85 / URL</li>
            <li>Hexadecimal</li>
            <li>Binary & Morse</li>
          </ul>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-error font-label-caps text-label-caps border-b border-outline-variant pb-2">UTILITIES</h3>
          <ul class="font-code-block text-code-block text-on-surface-variant space-y-2 mt-2 list-disc pl-4">
            <li>Burnable Links</li>
            <li>Password Gen</li>
            <li>JSON Formatter</li>
            <li>JWT Decoder</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- WebTech60 Section -->
      <section class="bg-[#141416]/60 backdrop-blur-[20px] panel-border p-8 relative rounded-sm group hover:border-secondary-fixed-dim/50 transition-colors flex flex-col">
        <div class="corner-tl corner-accent group-hover:border-secondary-fixed-dim"></div><div class="corner-tr corner-accent group-hover:border-secondary-fixed-dim"></div><div class="corner-bl corner-accent group-hover:border-secondary-fixed-dim"></div><div class="corner-br corner-accent group-hover:border-secondary-fixed-dim"></div>
        <div class="font-status-label text-status-label text-on-surface-variant absolute top-0 left-0 bg-surface-container-lowest px-2 py-1 border-b border-r border-outline-variant rounded-br-sm">[AUTHOR_01]</div>
        
        <h2 class="font-headline-md text-headline-md tracking-widest mb-4 mt-6 flex items-center gap-3">
          <span class="material-symbols-outlined text-secondary-fixed-dim">bolt</span> ABOUT WEBTECH60
        </h2>
        <p class="font-code-block text-code-block text-on-surface-variant leading-relaxed mb-8 flex-1">
          CryptoWeb is proudly developed and maintained by <strong class="text-secondary-fixed-dim">WebTech60 Studio</strong>. We specialize in building high-performance, secure, and modern web applications tailored to your business needs. From complex backend architectures to stunning frontend interfaces, we deliver excellence without compromise.
        </p>
        <a href="https://webtech60.ru" target="_blank" class="w-full border border-secondary-fixed-dim text-secondary-fixed-dim text-center font-label-caps text-label-caps py-3 rounded-sm hover:bg-secondary-fixed-dim hover:text-background transition-all duration-200">
          ESTABLISH CONNECTION -> WEBTECH60.RU
        </a>
      </section>

      <!-- Feedback Form -->
      <section class="bg-[#141416]/60 backdrop-blur-[20px] panel-border p-8 relative rounded-sm group hover:border-primary/50 transition-colors">
        <div class="corner-tl corner-accent group-hover:border-primary"></div><div class="corner-tr corner-accent group-hover:border-primary"></div><div class="corner-bl corner-accent group-hover:border-primary"></div><div class="corner-br corner-accent group-hover:border-primary"></div>
        <div class="font-status-label text-status-label text-on-surface-variant absolute top-0 left-0 bg-surface-container-lowest px-2 py-1 border-b border-r border-outline-variant rounded-br-sm">[COMM_LINK_01]</div>
        
        <h2 class="font-headline-md text-headline-md tracking-widest mb-2 mt-6">SECURE TRANSMISSION</h2>
        <p class="font-code-block text-code-block text-on-surface-variant mb-6">Found a vulnerability? Need a custom deployment? Send an encrypted transmission directly to our terminal.</p>

        <form id="feedbackForm" class="flex flex-col gap-4">
          <!-- Honeypot field -->
          <div class="opacity-0 absolute -left-[9999px] top-0 pointer-events-none" aria-hidden="true">
            <label for="website">Website (Leave blank)</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label for="fbName" class="font-status-label text-status-label text-primary-fixed-dim">OPERATIVE (NAME)</label>
              <input type="text" id="fbName" required class="bg-black/40 border border-outline-variant p-2 font-code-block text-code-block text-on-surface focus:outline-none focus:border-primary-fixed-dim transition-colors rounded-sm" />
            </div>
            <div class="flex flex-col gap-1">
              <label for="fbEmail" class="font-status-label text-status-label text-primary-fixed-dim">RETURN PATH (EMAIL)</label>
              <input type="email" id="fbEmail" required class="bg-black/40 border border-outline-variant p-2 font-code-block text-code-block text-on-surface focus:outline-none focus:border-primary-fixed-dim transition-colors rounded-sm" />
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <label for="fbMessage" class="font-status-label text-status-label text-primary-fixed-dim">PAYLOAD (MESSAGE)</label>
            <textarea id="fbMessage" required rows="4" class="bg-black/40 border border-outline-variant p-2 font-code-block text-code-block text-on-surface focus:outline-none focus:border-primary-fixed-dim transition-colors rounded-sm resize-none"></textarea>
          </div>

          <button type="submit" id="fbSubmit" class="btn-tech w-full py-3 font-label-caps text-label-caps rounded-sm flex items-center justify-center gap-2 mt-2">
            <span class="material-symbols-outlined text-[18px]">send</span> TRANSMIT
          </button>
          
          <div id="fbStatus" class="font-status-label text-status-label hidden mt-2 text-center"></div>
        </form>
      </section>

    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('feedbackForm') as HTMLFormElement;
  const submitBtn = document.getElementById('fbSubmit') as HTMLButtonElement;
  const statusDiv = document.getElementById('fbStatus') as HTMLDivElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const name = (document.getElementById('fbName') as HTMLInputElement).value;
    const email = (document.getElementById('fbEmail') as HTMLInputElement).value;
    const message = (document.getElementById('fbMessage') as HTMLTextAreaElement).value;
    const website = (document.getElementById('website') as HTMLInputElement).value; // honeypot
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> TRANSMITTING...';
    statusDiv.className = 'font-status-label text-status-label hidden mt-2 text-center';
    
    try {
      const res = await fetch('/api/feedback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, message, website })
      });
      
      const data = await res.json();
      
      if (!res.ok) {
        throw new Error(data.detail || 'Failed to send message');
      }
      
      form.reset();
      statusDiv.textContent = data.message || 'TRANSMISSION SUCCESSFUL';
      statusDiv.className = 'font-status-label text-status-label text-primary-fixed-dim mt-2 text-center';
    } catch (err: any) {
      statusDiv.textContent = 'ERROR: ' + err.message;
      statusDiv.className = 'font-status-label text-status-label text-error mt-2 text-center';
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">send</span> TRANSMIT';
    }
  });
</script>
